{
  "name": "iocraft",
  "version": "0.3.0",
  "description": "A lightweight IOC container for Vue 3 using the Composition API.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/istiuak-0/iocraft#readme",
  "bugs": {
    "url": "https://github.com/istiuak-0/iocraft/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/istiuak-0/iocraft.git"
  },
  "author": {
    "name": "Istiuak",
    "url": "https://github.com/istiuak-0"
  },
  "keywords": [
    "vue",
    "vue3",
    "dependency-injection",
    "di",
    "ioc",
    "Inversion of Control",
    "composition-api",
    "typescript",
    "spa",
    "vue-plugin"
  ],
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "bench": "vitest bench",
    "change": "beachball change",
    "bump": "beachball bump",
    "release": "beachball publish --yes --access public"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "beachball": "^2.66.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.16",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },

  "publishConfig": {
    "access": "public"
  }
}